<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext must stay permitted for plain http/ws LAN traffic to the desktop server; drop it only when wss-everywhere lands (relay milestone M5.1). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
